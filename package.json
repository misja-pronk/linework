{
  "name": "cartography",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Architecture diagrams as text: YAML in, a clean and consistent drawing out",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OWNER/cartography.git"
  },
  "homepage": "https://github.com/OWNER/cartography#readme",
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "build": "pnpm web:build && node scripts/bundle.mjs",
    "build:cli": "pnpm web:build && node scripts/bundle.mjs cli",
    "build:mcp": "node scripts/bundle.mjs mcp",
    "smoke": "node scripts/smoke-bundles.mjs",
    "validators": "tsx scripts/validators.ts",
    "carto": "tsx packages/cli/src/main.ts",
    "mcp": "tsx packages/mcp/src/main.ts",
    "gallery": "tsx packages/cli/src/gallery.ts",
    "themes": "tsx packages/cli/src/theme-gallery.ts",
    "compare": "tsx packages/cli/src/compare.ts",
    "fonts": "node scripts/fonts.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "icons": "node scripts/icons.mjs",
    "lab": "tsx packages/cli/src/lab.ts",
    "snapshot": "tsx packages/cli/src/snapshot.ts",
    "stability": "tsx packages/engine/test/stability.ts",
    "web": "pnpm --filter @cartography/web dev",
    "web:build": "pnpm --filter @cartography/web build",
    "docs:build": "pnpm --filter @cartography/web build && pnpm --filter @cartography/site build",
    "docs:serve": "pnpm --filter @cartography/site serve",
    "bench": "pnpm --filter @cartography/site bench",
    "licences": "node scripts/licences.mjs",
    "pack:check": "node scripts/pack-check.mjs",
    "e2e:templates": "node packages/web/e2e/templates.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "fontkit": "^2.0.4",
    "inter-ui": "4.1.1",
    "subset-font": "^2.9.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0",
    "wawoff2": "^2.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
