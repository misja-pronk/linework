exports[`templates > mindmap renders without problems 1`] = `
"<svg xmlns="http://www.w3.org/2000/svg" width="994" height="502" viewBox="0 0 994 502" font-family="'Instrument Sans', Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif" text-rendering="geometricPrecision" role="img" aria-labelledby="carto-11h11qw651-title" aria-describedby="carto-11h11qw651-desc" lang="en" xml:lang="en"><title id="carto-11h11qw651-title">Which event store?</title><desc id="carto-11h11qw651-desc">Mind map: Architecture decision brainstorm, before the ADR. Around Event store for Orders, 5 branches and 20 topics in all.

Topics
- Options
  - EventStoreDB (Built for event sourcing)
  - Kafka (A log rather than a store)
  - Postgres with an outbox
  - DynamoDB streams
- Must have
  - Replay a stream from any point
  - Optimistic concurrency per stream
  - Subscriptions with at-least-once delivery
- Operations
  - Who runs it at night
  - Backups and restore drills
  - Managed offering in our region
- Risks
  - Nobody on the team knows it yet
  - Lock-in to one vendor
- Next steps
  - Spike on two options
  - Write the ADR</desc><defs></defs><rect width="994" height="502" fill="#FFFFFF"/><g data-sheet=""><path d="M21 12H12V21" fill="none" stroke="#5D6670" stroke-width="1"/><path d="M973 12H982V21" fill="none" stroke="#5D6670" stroke-width="1"/><path d="M21 490H12V481" fill="none" stroke="#5D6670" stroke-width="1"/><path d="M973 490H982V481" fill="none" stroke="#5D6670" stroke-width="1"/></g><text x="40" y="56" font-size="20" font-weight="600" fill="#16212C">Which event store?</text><text x="40" y="80" font-size="13" font-weight="400" fill="#4F5B66">Architecture decision brainstorm, before the ADR</text><g transform="translate(40 104)"><g><path d="M558 176L559.8 175.5Q561.5 175.1 562.9 173.9L563.1 173.8Q564.6 172.5 565.8 170.9L566 170.5Q567.4 168.5 568.4 166.3L568.6 165.9Q569.9 163.3 570.9 160.6L571 160.3Q572.1 157.2 573.1 154.1L573.1 153.8Q574.2 150.4 575.1 146.9L575.1 146.7Q576.1 143.1 577 139.4L577.1 139.3Q578 135.5 578.9 131.7L579 131.6Q579.9 127.9 580.9 124.3L580.9 124.1Q581.8 120.6 582.9 117.2L582.9 116.9Q583.9 113.8 585 110.7L585.1 110.4Q586.1 107.7 587.4 105.1L587.6 104.7Q588.6 102.5 590 100.5L590.2 100.1Q591.4 98.5 592.9 97.2L593.1 97.1Q594.5 95.9 596.2 95.5L598 95" fill="none" stroke="#2B62A3" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" stroke-opacity="0.9"/></g><g><path d="M678 95L690 95Q698 95 698 87L698 31Q698 23 706 23L718 23" fill="none" stroke="#2B62A3" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" stroke-opacity="0.9"/></g><g><path d="M678 95L690 95Q698 95 698 87L698 87Q698 79 706 79L718 79" fill="none" stroke="#2B62A3" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" stroke-opacity="0.9"/></g><g><path d="M678 95L690 95Q698 95 698 103L698 119Q698 127 706 127L718 127" fill="none" stroke="#2B62A3" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" stroke-opacity="0.9"/></g><g><path d="M678 95L690 95Q698 95 698 103L698 159Q698 167 706 167L718 167" fill="none" stroke="#2B62A3" strok