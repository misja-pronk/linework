95" stroke-width="4.9" stroke-dasharray="1.1 15" stroke-dashoffset="-7"/><text x="293.8" y="713.1" font-size="11.5" font-weight="500" fill="#4F5B66">WAN</text><path d="M345.938 709H365.938" stroke="#1E7495" stroke-width="1.7" stroke-linecap="round" stroke-dasharray="1.5 3.5"/><text x="373.9" y="713.1" font-size="11.5" font-weight="500" fill="#4F5B66">Wireless</text></svg>"
