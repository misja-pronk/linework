 66L319.7 65.4Q318.6 63.4 317.1 61.8L316.8 61.5Q315.5 60.2 313.8 59.6L312 59" fill="none" stroke="#9B2834" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" stroke-opacity="0.9"/></g><g><path d="M216 59L204 59Q196 59 196 51L196 47Q196 39 188 39L176 39" fill="none" stroke="#9B2834" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" stroke-opacity="0.9"/></g><g><path d="M216 59L204 59Q196 59 196 67L196 71Q196 79 188 79L176 79" fill="none" stroke="#9B2834" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" stroke-opacity="0.9"/></g><g><rect x="352" y="150" width="206" height="50" rx="10" fill="#16212C"/><text x="372" y="180.8" font-size="16" font-weight="600" fill="#FFFFFF">Event store for Orders</text></g><g><rect x="598" y="77" width="80" height="36" rx="6" fill="#E1E9F2" stroke="#95B1D1" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/><text x="612" y="99.9" font-size="13.5" font-weight="600" fill="#16212C">Options</text></g><g><rect x="718" y="0" width="134" height="46" rx="6" fill="#FFFFFF" stroke="#AAC0DA" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/><text x="729" y="19.5" font-size="12.5" font-weight="500" fill="#16212C">EventStoreDB</text><text x="729" y="35.8" font-size="10.5" font-weight="400" fill="#4F5B66">Built for event sourcing</text></g><g><rect x="718" y="56" width="138" height="46" rx="6" fill="#FFFFFF" stroke="#AAC0DA" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/><text x="729" y="75.5" font-size="12.5" font-weight="500" fill="#16212C">Kafka</text><text x="729" y="91.8" font-size="10.5" font-weight="400" fill="#4F5B66">A log rather than a store</text></g><g><rect x="718" y="112" width="162" height="30" rx="6" fill="#FFFFFF" stroke="#AAC0DA" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/><text x="729" y="131.5" font-size="12.5" font-weight="500" fill="#16212C">Postgres with an outbox</text></g><g><rect x="718" y="152" width="140" height="30" rx="6" fill="#FFFFFF" stroke="#AAC0DA" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/><text x="729" y="171.5" font-size="12.5" font-weight="500" fill="#16212C">DynamoDB streams</text></g><g><rect x="598" y="253" width="94" height="36" rx="6" fill="#E1EAE8" stroke="#95B5AE" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/><text x="612" y="275.9" font-size="13.5" font-weight="600" fill="#16212C">Must have</text></g><g><rect x="732" y="192" width="168" height="46" rx="6" fill="#FFFFFF" stroke="#AAC4BE" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/><text x="743" y="211.5" font-size="12.5" font-weight="500" fill="#16212C">Replay a stream from any</text><text x="743" y="227.5" font-size="12.5" font-weight="500" fill="#16212C">point</text></g><g><rect x="732" y="248" width="182" height="46" rx="6" fill="#FFFFFF" stroke="#AAC4BE" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/><text x="743" y="267.5" font-size="12.5" font-weight="500" fill="#16212C">Optimistic concurrency per</text><text x="743" y="283.5" font-size="12.5" font-weight="500" fill="#16212C">stream</text></g><g><rect x="732" y="304" width="150" height="46" rx="6" fill="#FFFFFF" stroke="#AAC4BE" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/><text x="743" y="323.5" font-size="12.5" font-weight="500" fill="#16212C">Subscriptions with</text><text x="743" y="339.5" font-size="12.5" font-weight="500" fill="#16212C">at-least-once delivery</text></g><g><rect x="212" y="237" width="100" height="36" rx="6" fill="#ECE7F6" stroke="#BBAAE0" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/><text x="226" y="259.9" font-size="13.5" font-weight="600" fill="#16212C">Operations</text></g><g><rect x="34" y="200" width="138" height="30" rx="6" fill="#FFFFFF" stroke="#C8BBE6" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/><text x="45" y="219.5" font-size="12.5" font-weight="500" fill="#16212C">Who runs it at night</text></g><g><rect x="0" y="240" width="172" height="30" rx="6" fill="#FFFFFF" stroke="#C8BBE6" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/><text x="11" y="259.5" font-size="12.5" font-weight="500" fill="#16212C">Backups and restore drills</text></g><g><rect x="10" y="280" width="162" height="46" rx="6" fill="#FFFFFF" stroke="#C8BBE6" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/><text x="21" y="299.5" font-size="12.5" font-weight="500" fill="#16212C">Managed offering in our</text><text x="21" y="315.5" font-size="12.5" font-weight="500" fill="#16212C">region</text></g><g><rect x="248" y="133" width="64" height="36" rx="6" fill="#EDE9DE" stroke="#C0B28A" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/><text x="262" y="155.9" font-size="13.5" font-weight="600" fill="#16212C">Risks</text></g><g><rect x="16" y="104" width="192" height="46" rx="6" fill="#FFFFFF" stroke="#CCC1A1" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/><text x="27" y="123.5" font-size="12.5" font-weight="500" fill="#16212C">Nobody on the team knows it</text><text x="27" y="139.5" font-size="12.5" font-weight="500" fill="#16212C">yet</text></g><g><rect x="60" y="160" width="148" height="30" rx="6" fill="#FFFFFF" stroke="#CCC1A1" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/><text x="71" y="179.5" font-size="12.5" font-weight="500" fill="#16212C">Lock-in to one vendor</text></g><g><rect x="216" y="41" width="96" height="36" rx="6" fill="#F1E1E3" stroke="#CD949A" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/><text x="230" y="63.9" font-size="13.5" font-weight="600" fill="#16212C">Next steps</text></g><g><rect x="32" y="24" width="144" height="30" rx="6" fill="#FFFFFF" stroke="#D7A9AE" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/><text x="43" y="43.5" font-size="12.5" font-weight="500" fill="#16212C">Spike on two options</text></g><g><rect x="68" y="64" width="108" height="30" rx="6" fill="#FFFFFF" stroke="#D7A9AE" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/><text x="79" y="83.5" font-size="12.5" font-weight="500" fill="#16212C">Write the ADR</text></g></g></svg>"
`;

exports[`templates > network renders without problems 1`] = `
"<svg xmlns="http://www.w3.org/2000/svg" width="1136" height="763" viewBox="0 0 1136 763" font-family="'Instrument Sans', Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif" text-rendering="geometricPrecision" role="img" aria-labelledby="carto-hteu38771-title" aria-describedby="carto-hteu38771-desc" lang="en" xml:lang="en"><title id="carto-hteu38771-title">Office network</title><desc id="carto-hteu38771-desc">Network diagram: Amsterdam. 6 elements in 4 groups, with 5 connections.

Groups and elements
- Internet
  - Fibre ISP
- Amsterdam office (10.10.0.0/16)
  - fw (FortiGate 60F · 10.10.0.1 · HA pair)
  - core (USW Pro 24 PoE · 10.10.0.2)
  - Staff (VLAN 10 · 10.10.10.0/24)
    - ap-floor1 (U6 Pro)
    - Laptops (Clients)
  - Guest (VLAN 30 · 10.10.30.0/24)
    - Guest devices (Clients)

Connections
- Fibre ISP connects to fw (WAN: 1G).
- fw connects to core (Trunk: 2×1G · VLAN 10, 30).
- core is linked with ap-floor1 (1G · port 5 ↔ eth0).
- ap-floor1 connects to Laptops (Wireless) and connects to Guest devices (Wireless).

Key
- Solid line: Ethernet
- Solid indigo line, double, thick: Trunk
- Solid sky line with ticks: WAN
- Dotted sky line: Wireless</desc><defs></defs><rect width="1136" height="763" fill="#FFFFFF"/><g data-sheet=""><path d="M21 12H12V21" fill="none" stroke="#5D6670" stroke-width="1"/><path d="M1115 12H1124V21" fill="none" stroke="#5D6670" stroke-width="1"/><path d="M21 751H12V742" fill="none" stroke="#5D6670" stroke-width="1"/><path d="M1115 751H1124V742" fill="none" stroke="#5D6670" stroke-width="1"/></g><text x="40" y="56" font-size="20" font-weight="600" fill="#16212C">Office network</text><text x="40" y="80" font-size="13" font-weight="400" fill="#4F5B66">Amsterdam</text><g transform="translate(40 104)"><g><rect x="78" y="3" width="260" height="134" rx="8" fill="#F8F6F1" stroke="#9A9485" stroke-width="1" stroke-dasharray="4 3"/><g transform="translate(94 18) scale(0.5833333333333334)" fill="none" stroke="#4E5A65" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></g><text x="116" y="28.8" font-size="10.5" font-weight="600" fill="#4F5B66" letter-spacing="1">INTERNET</text></g><g><rect x="3.5" y="200" width="1051.6" height="365" rx="8" fill="#F8F6F1" stroke="#9A9485" stroke-width="1"/><g transform="translate(19.5 215) scale(0.5833333333333334)" fill="none" stroke="#4E5A65" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M12 10h.01"/><path d="M12 14h.01"/><path d="M12 6h.01"/><path d="M16 10h.01"/><path d="M16 14h.01"/><path d="M16 6h.01"/><path d="M8 10h.01"/><path d="M8 14h.01"/><path d="M8 6h.01"/><path d="M9 22v-3a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v3"/><rect x="4" y="2" width="16" height="20" rx="2"/></g><text x="41.5" y="225.8" font-size="10.5" font-weight="600" fill="#4F5B66" letter-spacing="1">AMSTERDAM OFFICE</text><text x="174" y="226.1" font-size="11.5" font-weight="400" fill="#4F5B66">10.10.0.0/16</text></g><g><rect x="380" y="259" width="297.5" height="286" rx="8" fill="#F0EDE4" stroke="#9A9485" stroke-width="1"