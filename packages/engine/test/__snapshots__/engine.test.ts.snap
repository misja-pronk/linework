exports[`templates > mindmap renders without problems 1`] = `
"<svg xmlns="http://www.w3.org/2000/svg" width="994" height="494" viewBox="0 0 994 494" font-family="'Instrument Sans', Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif" text-rendering="geometricPrecision" role="img" aria-labelledby="carto-11h11qw651-title" aria-describedby="carto-11h11qw651-desc" lang="en" xml:lang="en"><title id="carto-11h11qw651-title">Which event store?</title><desc id="carto-11h11qw651-desc">Mind map: Architecture decision brainstorm, before the ADR. Around Event store for Orders, 5 branches and 20 topics in all.

Topics
- Options
  - EventStoreDB (Built for event sourcing)
  - Kafka (A log rather than a store)
  - Postgres with an outbox
  - DynamoDB streams
- Must have
  - Replay a stream from any point
  - Optimistic concurrency per stream
  - Subscriptions with at-least-once delivery
- Operations
  - Who runs it at night
  - Backups and restore drills
  - Managed offering in our region
- Risks
  - Nobody on the team knows it yet
  - Lock-in to one vendor
- Next steps
  - Spike on two options
  - Write the ADR</desc><defs></defs><rect width="994" height="494" fill="#FFFFFF"/><g data-sheet=""><path d="M21 12H12V21" fill="none" stroke="#5D6670" stroke-width="1"/><path d="M973 12H982V21" fill="none" stroke="#5D6670" stroke-width="1"/><path d="M21 482H12V473" fill="none" stroke="#5D6670" stroke-width="1"/><path d="M973 482H982V473" fill="none" stroke="#5D6670" stroke-width="1"/></g><text x="40" y="56" font-size="20" font-weight="600" fill="#16212C">Which event store?</text><text x="40" y="80" font-size="13" font-weight="400" fill="#4F5B66">Architecture decision brainstorm, before the ADR</text><g transform="translate(40 104)"><g><path d="M558 168L559.8 167.6Q561.5 167.2 563 166.1L563.1 166Q564.6 164.9 565.8 163.3L566 163.1Q567.4 161.3 568.5 159.3L568.6 158.9Q569.9 156.6 570.9 154.1L571 153.8Q572.1 151.1 573.1 148.2L573.1 148Q574.2 144.9 575.1 141.8L575.1 141.6Q576.1 138.3 577 135L577.1 134.9Q578 131.5 578.9 128.1L579 128Q579.9 124.7 580.9 121.4L580.9 121.2Q581.8 118.1 582.9 115L582.9 114.8Q583.9 111.9 585 109.2L585.1 108.9Q586.1 106.4 587.4 104.1L587.5 103.7Q588.6 101.7 590 99.9L590.2 99.7Q591.4 98.1 592.9 97L593 96.9Q594.5 95.8 596.2 95.4L598 95" fill="none" stroke="#2B62A3" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" stroke-opacity="0.9"/></g><g><path d="M678 95L690 95Q698 95 698 87L698 31Q698 23 706 23L718 23" fill="none" stroke="#2B62A3" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" stroke-opacity="0.9"/></g><g><path d="M678 95L690 95Q698 95 698 87L698 87Q698 79 706 79L718 79" fill="none" stroke="#2B62A3" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" stroke-opacity="0.9"/></g><g><path d="M678 95L690 95Q698 95 698 103L698 119Q698 127 706 127L718 127" fill="none" stroke="#2B62A3" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" stroke-opacity="0.9"/></g><g><path d="M678 95L690 95Q698 95 698 103L698 159Q698 167 706 167L718 167" fill="none" stroke="#2B62A3" stroke-width="1.7" stro