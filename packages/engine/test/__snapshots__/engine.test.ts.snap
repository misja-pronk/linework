ight="600" fill="#FFFFFF" text-anchor="middle">6</text><text x="498" y="408.3" font-size="12" font-weight="500" fill="#16212C" text-anchor="middle" stroke="#F0EDE4" stroke-width="4" stroke-linejoin="round" paint-order="stroke">card_declined</text><path d="M423 462H244" stroke="#5E6A75" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" fill="none" stroke-dasharray="5 4"/><path d="M251 457.5L243 462L251 466.5" stroke="#5E6A75" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" fill="none"/><circle cx="412" cy="462" r="9" fill="#16212C"/><text x="412" y="465.6" font-size="10" font-weight="600" fill="#FFFFFF" text-anchor="middle">7</text><text x="321" y="452.3" font-size="12" font-weight="500" fill="#16212C" text-anchor="middle" stroke="#F0EDE4" stroke-width="4" stroke-linejoin="round" paint-order="stroke">402 Payment required</text><path d="M233 518H59" stroke="#5E6A75" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" fill="none" stroke-dasharray="5 4"/><path d="M66 513.5L58 518L66 522.5" stroke="#5E6A75" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" fill="none"/><circle cx="222" cy="518" r="9" fill="#16212C"/><text x="222" y="521.6" font-size="10" font-weight="600" fill="#FFFFFF" text-anchor="middle">8</text><text x="133.5" y="508.3" font-size="12" font-weight="500" fill="#16212C" text-anchor="middle" stroke="#FFFFFF" stroke-width="4" stroke-linejoin="round" paint-order="stroke">Confirmation</text><rect x="0" y="32" width="116" height="54" rx="6" fill="#FFFFFF" stroke="#99948A" stroke-width="1"/><g transform="translate(20.6 49) scale(0.8333333333333334)" fill="none" stroke="#4E5A65" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></g><text x="55.6" y="63.9" font-size="13.5" font-weight="600" fill="#16212C">Person</text><rect x="172" y="32" width="132" height="54" rx="6" fill="#FFFFFF" stroke="#99948A" stroke-width="1"/><g transform="translate(189.8 49) scale(0.8333333333333334)" fill="none" stroke="#1E7495" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M10 4v4"/><path d="M2 8h20"/><path d="M6 4v4"/></g><text x="224.8" y="55.9" font-size="13.5" font-weight="600" fill="#16212C">Storefront</text><text x="224.8" y="72.1" font-size="11.5" font-weight="400" fill="#4F5B66">Web app</text><rect x="365" y="32" width="116" height="54" rx="6" fill="#FFFFFF" stroke="#99948A" stroke-width="1"/><g transform="translate(386.1 49) scale(0.8333333333333334)" fill="none" stroke="#2B62A3" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></g><text x="421.1" y="55.9" font-size="13.5" font-weight="600" fill="#16212C">Orders</text><text x="421.1" y="72.1" font-size="11.5" font-weight="400" fill="#4F5B66">Service</text><rect x="537.5" y="32" width="119" height="54" rx="6" fill="#FFFFFF" stroke="#99948A" stroke-width="1"/><g transform="translate(555.7 49) scale(0.8333333333333334)" fill="none" stroke="#3D7938" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/><path d="M6 14h2"/></g><text x="590.7" y="55.9" font-size="13.5" font-weight="600" fill="#16212C">Stripe</text><text x="590.7" y="72.1" font-size="11.5" font-weight="400" fill="#4F5B66">Payments</text></g></g></g></svg>"
