1.854 2.147-10.94 10.939"/></g><text x="892" y="340.9" font-size="13.5" font-weight="600" fill="#16212C">order-events</text><text x="892" y="357.6" font-size="11.5" font-weight="400" fill="#4F5B66">Queue</text></g><g><rect x="1106" y="315" width="172" height="58" rx="6" fill="#FFFFFF" stroke="#99948A" stroke-width="1"/><g transform="translate(1124 333) scale(0.9166666666666666)" fill="none" stroke="#2B62A3" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M11 10.27 7 3.34"/><path d="m11 13.73-4 6.93"/><path d="M12 22v-2"/><path d="M12 2v2"/><path d="M14 12h8"/><path d="m17 20.66-1-1.73"/><path d="m17 3.34-1 1.73"/><path d="M2 12h2"/><path d="m20.66 17-1.73-1"/><path d="m20.66 7-1.73 1"/><path d="m3.34 17 1.73-1"/><path d="m3.34 7 1.73 1"/><circle cx="12" cy="12" r="2"/><circle cx="12" cy="12" r="8"/></g><text x="1164" y="340.9" font-size="13.5" font-weight="600" fill="#16212C">Mailer</text><text x="1164" y="357.6" font-size="11.5" font-weight="400" fill="#4F5B66">Worker</text></g><g><rect x="834" y="436" width="172" height="58" rx="6" fill="#FFFFFF" stroke="#99948A" stroke-width="1"/><g transform="translate(852 454) scale(0.9166666666666666)" fill="none" stroke="#3D7938" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/><path d="M6 14h2"/></g><text x="892" y="461.9" font-size="13.5" font-weight="600" fill="#16212C">Stripe</text><text x="892" y="478.6" font-size="11.5" font-weight="400" fill="#4F5B66">Payments</text></g><rect x="161.2" y="212.3" width="37.5" height="16" rx="2" fill="#F8F6F1"/><text x="180" y="224" font-size="10.5" font-weight="500" fill="#4F5B66" text-anchor="middle" font-family="'Geist Mono', ui-monospace, 'SF Mono', Menlo, Consolas, monospace">HTTPS</text><rect x="228.4" y="336" width="31.2" height="16" rx="2" fill="#F8F6F1"/><text x="244" y="347.7" font-size="10.5" font-weight="500" fill="#4F5B66" text-anchor="middle" font-family="'Geist Mono', ui-monospace, 'SF Mono', Menlo, Consolas, monospace">REST</text><rect x="755.1" y="327.5" width="24.9" height="16" rx="2" fill="#F0EDE4"/><text x="767.5" y="339.2" font-size="10.5" font-weight="500" fill="#4F5B66" text-anchor="middle" font-family="'Geist Mono', ui-monospace, 'SF Mono', Menlo, Consolas, monospace">SQL</text><rect x="746.4" y="357.5" width="75.3" height="16" rx="2" fill="#F0EDE4"/><text x="784" y="369.2" font-size="10.5" font-weight="500" fill="#4F5B66" text-anchor="middle" font-family="'Geist Mono', ui-monospace, 'SF Mono', Menlo, Consolas, monospace">OrderPlaced</text><rect x="719.1" y="457" width="43.8" height="16" rx="2" fill="#FFFFFF"/><text x="741" y="468.7" font-size="10.5" font-weight="500" fill="#4F5B66" text-anchor="middle" font-family="'Geist Mono', ui-monospace, 'SF Mono', Menlo, Consolas, monospace">charge</text></g><rect x="40" y="614" width="1318" height="1" fill="#99948A"/><text x="40" y="641.8" font-size="10.5" font-weight="600" letter-spacing="1.2" fill="#5D6670">KEY</text><path d="M84 638H104" stroke="#5E6A75" stroke-width="1.7" stroke-linecap="round"/><path d="M83 638H106" fill="none" stroke="#5E6A75" stroke-width="3.7" stroke-dasharray="0.01 16" stroke-dashoffset="-7" stroke-linecap="round"/><text x="112" y="642.1" font-size="11.5" font-weight="500" fill="#4F5B66">Connection</text><path d="M199.112 638H219.112" stroke="#2B62A3" stroke-width="1.7" stroke-linecap="round"/><text x="227.1" y="642.1" font-size="11.5" font-weight="500" fill="#4F5B66">Request</text><path d="M295.387 638H315.387" stroke="#806514" stroke-width="1.7" stroke-linecap="round" stroke-dasharray="6 4"/><text x="323.4" y="642.1" font-size="11.5" font-weight="500" fill="#4F5B66">Async message</text><path d="M431.06100000000004 638H451.06100000000004" stroke="#7655C1" stroke-width="1.7" stroke-linecap="round"/><path d="M430.06100000000004 638H453.06100000000004" fill="none" stroke="#7655C1" stroke-width="4.9" stroke-dasharray="1.1 15" stroke