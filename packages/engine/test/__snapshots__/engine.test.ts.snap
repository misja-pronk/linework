 stroke="#AAC0DA" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/><text x="729" y="171.5" font-size="12.5" font-weight="500" fill="#16212C">DynamoDB streams</text></g><g><rect x="598" y="253" width="94" height="36" rx="6" fill="#E1EAE8" stroke="#95B5AE" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/><text x="612" y="275.9" font-size="13.5" font-weight="600" fill="#16212C">Must have</text></g><g><rect x="732" y="192" width="168" height="46" rx="6" fill="#FFFFFF" stroke="#AAC4BE" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/><text x="743" y="211.5" font-size="12.5" font-weight="500" fill="#16212C">Replay a stream from any</text><text x="743" y="227.5" font-size="12.5" font-weight="500" fill="#16212C">point</text></g><g><rect x="732" y="248" width="182" height="46" rx="6" fill="#FFFFFF" stroke="#AAC4BE" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/><text x="743" y="267.5" font-size="12.5" font-weight="500" fill="#16212C">Optimistic concurrency per</text><text x="743" y="283.5" font-size="12.5" font-weight="500" fill="#16212C">stream</text></g><g><rect x="732" y="304" width="150" height="46" rx="6" fill="#FFFFFF" stroke="#AAC4BE" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/><text x="743" y="323.5" font-size="12.5" font-weight="500" fill="#16212C">Subscriptions with</text><text x="743" y="339.5" font-size="12.5" font-weight="500" fill="#16212C">at-least-once delivery</text></g><g><rect x="212" y="269" width="100" height="36" rx="6" fill="#ECE7F6" stroke="#BBAAE0" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/><text x="226" y="291.9" font-size="13.5" font-weight="600" fill="#16212C">Operations</text></g><g><rect x="34" y="232" width="138" height="30" rx="6" fill="#FFFFFF" stroke="#C8BBE6" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/><text x="45" y="251.5" font-size="12.5" font-weight="500" fill="#16212C">Who runs it at night</text></g><g><rect x="0" y="272" width="172" height="30" rx="6" fill="#FFFFFF" stroke="#C8BBE6" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/><text x="11" y="291.5" font-size="12.5" font-weight="500" fill="#16212C">Backups and restore drills</text></g><g><rect x="10" y="312" width="162" height="46" rx="6" fill="#FFFFFF" stroke="#C8BBE6" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/><text x="21" y="331.5" font-size="12.5" font-weight="500" fill="#16212C">Managed offering in our</text><text x="21" y="347.5" font-size="12.5" font-weight="500" fill="#16212C">region</text></g><g><rect x="248" y="165" width="64" height="36" rx="6" fill="#EDE9DE" stroke="#C0B28A" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/><text x="262" y="187.9" font-size="13.5" font-weight="600" fill="#16212C">Risks</text></g><g><rect x="16" y="136" width="192" height="46" rx="6" fill="#FFFFFF" stroke="#CCC1A1" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/><text x="27" y="155.5" font-size="12.5" font-weight="500" fill="#16212C">Nobody on the team knows it</text><text x="27" y="171.5" font-size="12.5" font-weight="500" fill="#16212C">yet</text></g><g><rect x="60" y="192" width="148" height="30" rx="6" fill="#FFFFFF" stroke="#CCC1A1" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/><text x="71" y="211.5" font-size="12.5" font-weight="500" fill="#16212C">Lock-in to one vendor</text></g><g><rect x="216" y="73" width="96" height="36" rx="6" fill="#F1E1E3" stroke="#CD949A" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/><text x="230" y="95.9" font-size="13.5" font-weight="600" fill="#16212C">Next steps</text></g><g><rect x="32" y="56" width="144" height="30" rx="6" fill="#FFFFFF" stroke="#D7A9AE" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/><text x="43" y="75.5" font-size="12.5" font-weight="500" fill="#16212C">Spike on two options</text></g><g><rect x="68" y="96" width="108" height="30" rx="6" fill="#FFFFFF" stroke="#D7A9AE" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/><text x="79" y="115.5" font-size="12.5" font-weight="500" fill="#16212C">Write the ADR</text></g></g></svg>"
`;

exports[`templates > network renders without problems 1`] = `
"<svg xmlns="http://www.w3.org/2000/svg" width="1128" height="763" viewBox="0 0 1128 763" font-family="'Instrument Sans', Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif" text-rendering="geometricPrecision" role="img" aria-labelledby="carto-84pzww820-title" aria-describedby="carto-84pzww820-desc" lang="en" xml:lang="en"><title id="carto-84pzww820-title">Office network</title><desc id="carto-84pzww820-desc">Network diagram: Amsterdam. 6 elements in 4 groups, with 5 connections.

Groups and elements
- Internet
  - Fibre ISP
- Amsterdam office (10.10.0.0/16)
  - fw (FortiGate 60F · 10.10.0.1 · HA pair)
  - core (USW Pro 24 · 10.10.0.2)
  - Staff (VLAN 10 · 10.10.10.0/24)
    - ap-floor1 (U6 Pro)
    - Laptops (Clients)
  - Guest (VLAN 30 · 10.10.30.0/24)
    - Guest devices (Clients)

Connections
- Fibre ISP connects to fw (WAN: 1G).
- fw connects to core (Trunk: 2×10G · VLAN 10, 30).
- core is linked with ap-floor1 (2.5G · port 5 ↔ eth0).
- ap-floor1 connects to Laptops (Wireless) and connects to Guest devices (Wireless).

Key
- Solid line: Ethernet
- Solid indigo line, double, thick: Trunk
- Solid sky line with ticks: WAN
- Dotted sky line: Wireless
- Solid line, thick: Aggregated link (2× or more)</desc><defs></defs><rect width="1128" height="763" fill="#FFFFFF"/><g data-sheet=""><path d="M21 12H12V21" fill="none" stroke="#5D6670" stroke-width="1"/><path d="M1107 12H1116V21" fill="none" stroke="#5D6670" stroke-width="1"/><path d="M21 751H12V742" fill="none" stroke="#5D6670" stroke-width="1"/><path d="M1107 751H1116V742" fill="none" stroke="#5D6670" stroke-width="1"/></g><text x="40" y="56" font-size="20" font-weight="600" fill="#16212C">Office network</text><text x="40" y="80" font-size="13" font-weight="400" fill="#4F5B66">Amsterdam</text><g transform="translate(40 104)"><g><rect x="86" y="3" width="260" height="134" rx="8" fill="#F8F6F1" stroke="#9A9485" stroke-width="1" stroke-dasharray="4 3"/><g transform="translate(102 18) scale(0.5833333333333334)" fill="none" stroke="#4E5A65" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></g><text x="124" y="28.8" font-size="10.5" font-weight="600" fill="#4F5B66" letter-spacing="1">INTERNET</text></g><g><rect x="7" y="200" width="1040.1" height="365" rx="8" fill="#F8F6F1" stroke="#9A9485" stroke-width="1"/><g transform="translate(23 215) scale(0.5833333333333334)" fill="none" stroke="#4E5A65" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M12 10h.01"/><path d="M12 14h.01"/><path d="M12 6h.01"/><path d="M16 10h.01"/><path d="M16 14h.01"/><path d="M16 6h.01"/><path d="M8 10h.01"/><path d="M8 14h.01"/><path d="M8 6h.01"/><path d="M9 22v-3a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v3"/><rect x="4" y="2" width="16" height="20" rx="2"/></g><text x="45" y="225.8" font-size="10.5" font-weight="600" fill="#4F5B66" letter-spacing="1">AMSTERDAM OFFICE</text><text x="177.5" y="226.1" font-size="11.5" font-weight="400" fill="#4F5B66">10.10.0.0/16</text></g><g><rect x="372" y="259" width="297.5" height="286" rx="8" fill="#F0EDE4" stroke="#9A948