" width="20" height="18" rx="5" fill="#E6EDF6"/><text x="94" y="612" font-size="11" font-weight="600" fill="#2B62A3" text-anchor="middle">R</text><text x="112" y="612.1" font-size="11.5" font-weight="500" fill="#4F5B66">Responsible: does the work</text><rect x="281" y="599" width="20.1" height="18" rx="5" fill="#F0E9F5"/><text x="291" y="612" font-size="11" font-weight="600" fill="#7655C1" text-anchor="middle">A</text><text x="309" y="612.1" font-size="11.5" font-weight="500" fill="#4F5B66">Accountable: signs off, one per activity</text><rect x="538.2" y="599" width="20.2" height="18" rx="5" fill="#E2F1EF"/><text x="548.3" y="612" font-size="11" font-weight="600" fill="#2A6B5C" text-anchor="middle">C</text><text x="566.2" y="612.1" font-size="11.5" font-weight="500" fill="#4F5B66">Consulted: asked before</text><rect x="719.6" y="599" width="20" height="18" rx="5" fill="#EDEBE6"/><text x="729.6" y="612" font-size="11" font-weight="600" fill="#4E5A65" text-anchor="middle">I</text><text x="747.6" y="612.1" font-size="11.5" font-weight="500" fill="#4F5B66">Informed: told after</text></svg>"
