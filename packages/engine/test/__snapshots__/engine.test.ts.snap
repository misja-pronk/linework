nd" stroke-linejoin="round"/><text x="312" y="500.9" font-size="13.5" font-weight="600" fill="#16212C" text-anchor="middle">Delivered</text></g><g><circle cx="472" cy="496" r="10.2" fill="#FFFFFF" stroke="#16212C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><circle cx="472" cy="496" r="6" fill="#16212C"/></g><g><rect x="18" y="365" width="140" height="70" rx="10" fill="#FFFFFF" stroke="#99948A" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/><text x="88" y="389.9" font-size="13.5" font-weight="600" fill="#16212C" text-anchor="middle">Cancelled</text><path d="M19 405L157 405" fill="none" stroke="#99948A" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/><text x="34" y="423.1" font-size="11.5" font-weight="400" fill="#4F5B66">entry / release stock</text></g><rect x="60.5" y="32" width="78" height="16" rx="2" fill="#FFFFFF"/><text x="99.5" y="43.6" font-size="10" font-weight="500" fill="#4F5B66" text-anchor="middle" font-family="'Geist Mono', ui-monospace, 'SF Mono', Menlo, Consolas, monospace">order placed</text><rect x="257" y="106" width="102" height="16" rx="2" fill="#FFFFFF"/><text x="308" y="117.6" font-size="10" font-weight="500" fill="#4F5B66" text-anchor="middle" font-family="'Geist Mono', ui-monospace, 'SF Mono', Menlo, Consolas, monospace">payment received</text><rect x="326.5" y="224" width="108" height="16" rx="2" fill="#F8F6F1"/><text x="380.5" y="235.6" font-size="10" font-weight="500" fill="#4F5B66" text-anchor="middle" font-family="'Geist Mono', ui-monospace, 'SF Mono', Menlo, Consolas, monospace">all items scanned</text><rect x="208.3" y="441" width="108" height="16" rx="2" fill="#FFFFFF"/><text x="262.3" y="452.6" font-size="10" font-weight="500" fill="#4F5B66" text-anchor="middle" font-family="'Geist Mono', ui-monospace, 'SF Mono', Menlo, Consolas, monospace">handed to carrier</text><rect x="156" y="508" width="66" height="16" rx="2" fill="#FFFFFF"/><text x="189" y="519.6" font-size="10" font-weight="500" fill="#4F5B66" text-anchor="middle" font-family="'Geist Mono', ui-monospace, 'SF Mono', Menlo, Consolas, monospace">signed for</text><rect x="47" y="127" width="138" height="16" rx="2" fill="#FFFFFF"/><text x="116" y="138.6" font-size="10" font-weight="500" fill="#4F5B66" text-anchor="middle" font-family="'Geist Mono', ui-monospace, 'SF Mono', Menlo, Consolas, monospace">30 min without payment</text><rect x="182.3" y="380.5" width="102" height="16" rx="2" fill="#FFFFFF"/><text x="233.3" y="392.1" font-size="10" font-weight="500" fill="#4F5B66" text-anchor="middle" font-family="'Geist Mono', ui-monospace, 'SF Mono', Menlo, Consolas, monospace">customer cancels</text></g></svg>"
`;

exports[`templates > systems renders without problems 1`] = `
"<svg xmlns="http://www.w3.org/2000/svg" width="1398" height="692" viewBox="0 0 1398 692" font-family="'Instrument Sans', Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif" text-rendering="geometricPrecision" role="img" aria-labelledby="carto-1pdrdtt756-title" aria-describedby="carto-1pdrdtt756-desc" lang="en" xml:lang="en"><title id="carto-1pdrdtt756-title">Web shop</title><desc id="carto-1pdrdtt756-desc">Architecture diagram: How an order flows through the system. 8 elements in 2 groups, with 7 connections.

Groups and elements
- Users
- Web shop (System)
  - Storefront (Web app)
  - API gateway
  - Private network (Zone)
    - Orders (Service)
    - Orders DB (Database)
    - order-events (Queue)
    - Mailer (Worker)
- Stripe (Payments)

Connections
- Users connect to Storefront over HTTPS.
- Storefront calls API gateway (REST).
- API gateway calls Orders.
- Orders sends data to Orders DB (SQL), sends OrderPlaced to order-events and calls Stripe (charge).
- order-events sends messages to Mailer.

Key
- Solid line with beads: Connection
- Solid blue line: Request
- Dashed violet line: Async message
- Solid teal line with ticks: Data flow</desc><defs></defs><rect width="1398" height="692" fill="#FFFFFF"/><g data-sheet=""><path d="M21 12H12V21" fill="none" stroke="#5D6670" stroke-width="1"/><path d="M1377 12H1386V21" fill="none" stroke="#5D6670" stroke-width="1"/><path d="M21 680H12V671" fill="none" stroke="#5D6670" stroke-width="1"/><path d="M1377 680H1386V671" fill="none" stroke="#5D6670" stroke-width="1"/></g><text x="40" y="56" font-size="20" font-weight="600" fill="#16212C">Web shop</text><text x="40" y="80" font-size="13" font-weight="400" fill="#4F5B66">How an order flows through the system</text><g transform="translate(40 104)"><g><rect x="6" y="136" width="1312" height="277" rx="8" fill="#F8F6F1" stroke="#9A9485" stroke-width="1"/><g transform="translate(22 151) scale(0.5833333333333334)" fill="none" stroke="#2B62A3" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M2.97 12.92A2 2 0 0 0 2 14.63v3.24a2 2 0 0 0 .97 1.71l3 1.8a2 2 0 0 0 2.06 0L12 19v-5.5l-5-3-4.03 2.42Z"/><path d="m7 16.5-4.74-2.85"/><path d="m7 16.5 5-3"/><path d="M7 16.5v5.17"/><path d="M12 13.5V19l3.97 2.38a2 2 0 0 0 2.06 0l3-1.8a2 2 0 0 0 .97-1.71v-3.24a2 2 0 0 0-.97-1.71L17 10.5l-5 3Z"/><path d="m17 16.5-5-3"/><path d="m17 16.5 4.74-2.85"/><path d="M17 16.5v5.17"/><path d="M7.97 4.42A2 2 0 0 0 7 6.13v4.37l5 3 5-3V6.13a2 2 0 0 0-.97-1.71l-3-1.8a2 2 0 0 0-2.06 0l-3 1.8Z"/><path d="M12 8 7.26 5.15"/><path d="m12 8 4.74-2.85"/><path d="M12 13.5V8"/></g><text x="44" y="161.8" font-size="10.5" font-weight="600" fill="#4F5B66" letter-spacing="1">WEB SHOP</text><text x="116.3" y="162.1" font-size="11.5" font-weight="400" fill="#4F5B66">System</text></g><g><rect x="542" y="180" width="756" height="213" rx="8" fill="#F0EDE4" stroke="#9A9485" stroke-width="1" stroke-dasharray="4 3"/><g transform="translate(558 195) scale(0.5833333333333334)" fill="none" stroke="#2A6B5C" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/></g><text x="580" y="205.8" font-size="10.5" font-weight="600" fill="#4F5B66" letter-spacing="1">PRIVATE NETWORK</text><text x="703" y="206.1" font-size="11.5" font-weight="400" fill="#4F5B66">Zone</text></g><g><path d="M88 61L88 117.5Q88 125.5 96 125.5L172 125.5Q180 125.5 180 133.5L180 310" fill="none" stroke="#5E6A75" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/><path d="M88 61L88 117.5Q88 125.5 96 125.5L172 125.5Q180 125.5 180 133.5L180 310" fill="none" stroke="#5E6A75" stroke-width="3.3" stroke-dasharray="0.01 16" stroke-dashoffset="-7" stroke-linecap="round"/><path d="M184.5 306L180 315L175.5 306Q180 308 184.5 306Z" fill="#5E6A75" stroke="#5E6A75" stroke-width="1" stroke-linejoin="round"/></g><g><path d="M198 344L285 344" fill="none" stroke="#2B62A3" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" stroke-opacity="0.9"/><path d="M281 339.5L290 344L281 348.5Q283 344 281 339.5Z" fill="#2B62A3" stroke="#2B62A3" stroke-width="1" stroke-linejoin="round"/></g><g><path d="M462 344L557 344" fill="none" stroke="#2B62A3" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" stroke-opacity="0.9"/><path d="M553 339.5L562 344L553 348.5Q555 344 553 339.5Z" fill="#2B62A3" stroke="#2B62A3" stroke-width="1" stroke-linejoin="round"/></g><g><path d="M734 344L829 344" fill="none" stroke="#2A6B5C" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" stroke-opacity="0.9"/><path d="M734 344L829 344" fill="none" stroke="#2A6B5C" stroke-width="4.5" stroke-dasharray="1.1 15" stroke-dashoffset="-7"/><path d="M825 339.5L834 344L825 348.5Q827 344 825 339.5Z" fill="#2A6B5C" stroke="#2A6B5C" stroke-width="1" stroke-linejoin="round"/></g><g><path d="M734 330L742 330Q750 330 750 322L750 261Q750 253 758 253L829 253" fill="none" stroke="#7655C1" stroke-width="1.3" stroke-linecap="round" stroke-linejo