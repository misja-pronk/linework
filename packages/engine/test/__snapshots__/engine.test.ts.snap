exports[`templates > journey renders without problems 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="1382" height="803" viewBox="0 0 1382 803" font-family="Inter, 'Inter Variable', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif" text-rendering="geometricPrecision"><defs><filter id="carto-shadow" x="-20%" y="-20%" width="140%" height="160%"><feDropShadow dx="0" dy="1" stdDeviation="1" flood-color="#0F172A" flood-opacity="0.084"/><feDropShadow dx="0" dy="4" stdDeviation="6" flood-color="#0F172A" flood-opacity="0.07"/></filter></defs><rect width="1382" height="803" fill="#FFFFFF"/><text x="40" y="56" font-size="20" font-weight="600" fill="#0F172A">A developer's first week</text><g transform="translate(40 84)"><g><g transform="translate(0 0)"><circle cx="28" cy="28" r="28" fill="#ECEBFD" stroke="#D5D3F8" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/><path d="M11.1 49.6C11.7 41.4 18.1 36.8 28 36.8C37.9 36.8 44.3 41.4 44.9 49.6" fill="none" stroke="#4F46E5" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="28" cy="21.6" r="9.3" fill="#ECEBFD" stroke="#4F46E5" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M17.5 29.2C16.3 26.3 16.3 23.9 16.3 21C16.3 13.4 21.6 8.8 28 8.8C34.4 8.8 39.7 13.4 39.7 21C39.7 23.9 39.7 26.3 38.5 29.2" fill="none" stroke="#4F46E5" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M20.1 18.2L35.9 18.2" fill="none" stroke="#4F46E5" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><text x="70" y="15.5" font-size="15" font-weight="600" fill="#0F172A">Dana</text><text x="70" y="32.9" font-size="12" font-weight="400" fill="#556070">New backend developer</text><text x="70" y="53.8" font-size="10.5" font-weight="600" fill="#8A93A2">Goal</text><text x="104" y="54.2" font-size="11.5" font-weight="400" fill="#556070">Ship a first change to production</text><rect x="311.5" y="11" width="218" height="36" rx="10" fill="#FFFFFF