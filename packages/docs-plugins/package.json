{
  "name": "@cartography/docs-plugins",
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "description": "Cartography diagrams in docs sites: remark and markdown-it plugins that draw YAML as inline SVG at build time",
  "keywords": [
    "cartography",
    "diagram",
    "architecture",
    "remark",
    "markdown-it",
    "docusaurus",
    "vitepress"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OWNER/cartography.git",
    "directory": "packages/docs-plugins"
  },
  "homepage": "https://github.com/OWNER/cartography#readme",
  "exports": {
    ".": "./src/index.ts",
    "./remark": "./src/remark.ts",
    "./markdown-it": "./src/markdown-it.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node build.mjs"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.js",
      "./remark": "./dist/remark.js",
      "./markdown-it": "./dist/markdown-it.js"
    }
  },
  "devDependencies": {
    "@cartography/core": "workspace:*",
    "@cartography/embed": "workspace:*",
    "@cartography/engine": "workspace:*",
    "@cartography/theme": "workspace:*",
    "@mdx-js/mdx": "^3.1.1",
    "@types/markdown-it": "^14.2.0",
    "esbuild": "^0.28.2",
    "markdown-it": "^15.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  }
}
