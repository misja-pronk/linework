@startuml
title Checkout with card payment
autonumber
skinparam responseMessageBelowArrow true

actor Shopper as user
participant "Storefront" as web
participant "Orders API" as api
database "Orders DB" as db
queue "order-events" as bus
participant Stripe as psp

user -> web : Place order
web -> api ++ : POST /orders
api -> db : INSERT order (pending)
db --> api : order id
== Payment ==
api -> psp ++ : Create payment intent
psp --> api -- : client secret
alt card accepted
  psp ->> api : webhook succeeded
  api -> db : UPDATE status = paid
  api ->> bus : OrderPaid
else card declined
  psp ->> api : webhook failed
  api -> db : UPDATE status = failed
end
loop every 10 seconds, at most 5 times
  web -> api : GET /orders/{id}
  api --> web : status
end
note over web, api : The browser never decides that an order is paid
return 201 Created
web --> user : Order confirmation
@enduml
