@startuml
title Shop deployment
left to right direction
skinparam componentStyle rectangle

actor "Customer" as customer
cloud "Internet" as internet

node "DMZ" {
  [Load balancer] as lb
}

package "Kubernetes cluster" {
  component "Storefront" as web
  component "Orders API" as api
  queue "order-events" as events
  component "Mailer worker" as mailer
}

database "Orders DB" as db
() "Payments API" as payments

customer --> internet
internet --> lb : HTTPS
lb --> web
web --> api : REST
api --> db : SQL
api ..> events : OrderPlaced
events ..> mailer
api --> payments : charge
note right of api : scales to 6 pods
@enduml
