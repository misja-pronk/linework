# Sign-in with OAuth, as a D2 sequence diagram.
shape: sequence_diagram
user: Shopper {shape: person}
app: Web app
idp: Identity provider
api: Orders API
db: Sessions DB {shape: cylinder}

user -> app: Sign in
app -> idp: Redirect to /authorize
idp -> user: Login page
user -> idp: Credentials
idp -> app: Authorization code {style.stroke-dash: 3}
app -> idp: Exchange code for tokens
idp -> app: Access and ID token {style.stroke-dash: 3}

"loop until the session expires": {
  app -> api: GET /orders with bearer token
  api -> db: Check session
  db -> api: ok {style.stroke-dash: 3}
  api -> app: Orders {style.stroke-dash: 3}
}

app."Keeps the refresh token server side"

alt token expired: {
  app -> idp: Refresh
  idp -> app: New access token {style.stroke-dash: 3}
}
