{
  "name": "@linework/vscode",
  "displayName": "Linework",
  "description": "Architecture diagrams as YAML: live preview, problems and quick fixes, and export",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "publisher": "linework",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Visualization",
    "Programming Languages"
  ],
  "keywords": [
    "architecture",
    "diagram",
    "yaml",
    "c4"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:yaml",
    "onWebviewPanel:linework.preview",
    "onMcpCollection:linework.mcp"
  ],
  "scripts": {
    "build": "node build.mjs",
    "package": "node build.mjs && node package.mjs",
    "e2e": "node e2e/webview.mjs"
  },
  "contributes": {
    "commands": [
      {
        "command": "linework.showPreview",
        "title": "Open Preview to the Side",
        "category": "Linework",
        "icon": "$(open-preview)"
      },
      {
        "command": "linework.present",
        "title": "Present",
        "category": "Linework",
        "icon": "$(play)"
      },
      {
        "command": "linework.newDiagram",
        "title": "New Diagram from Template…",
        "category": "Linework"
      },
      {
        "command": "linework.exportSvg",
        "title": "Export as SVG…",
        "category": "Linework"
      },
      {
        "command": "linework.exportPng",
        "title": "Export as PNG…",
        "category": "Linework"
      },
      {
        "command": "linework.exportPptx",
        "title": "Export as PowerPoint (.pptx)…",
        "category": "Linework"
      },
      {
        "command": "linework.copyShareLink",
        "title": "Copy Share Link",
        "category": "Linework"
      },
      {
        "command": "linework.openInEditor",
        "title": "Open in Linework Editor",
        "category": "Linework"
      },
      {
        "command": "linework.clearPins",
        "title": "Clear Pins of This View",
        "category": "Linework"
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "linework.mcp",
        "label": "Linework"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "linework.showPreview",
          "when": "linework.isDiagram",
          "group": "navigation"
        }
      ],
      "editor/title/context": [
        {
          "command": "linework.showPreview",
          "when": "linework.isDiagram"
        }
      ],
      "explorer/context": [
        {
          "command": "linework.showPreview",
          "when": "resourceFilename =~ /\\.linework\\.ya?ml$/",
          "group": "navigation@91"
        }
      ],
      "commandPalette": [
        {
          "command": "linework.showPreview",
          "when": "linework.isDiagram || activeWebviewPanelId == 'linework.preview'"
        },
        {
          "command": "linework.present",
          "when": "linework.isDiagram || activeWebviewPanelId == 'linework.preview'"
        },
        {
          "command": "linework.exportSvg",
          "when": "linework.isDiagram || activeWebviewPanelId == 'linework.preview'"
        },
        {
          "command": "linework.exportPng",
          "when": "linework.isDiagram || activeWebviewPanelId == 'linework.preview'"
        },
        {
          "command": "linework.exportPptx",
          "when": "linework.isDiagram || activeWebviewPanelId == 'linework.preview'"
        },
        {
          "command": "linework.copyShareLink",
          "when": "linework.isDiagram || activeWebviewPanelId == 'linework.preview'"
        },
        {
          "command": "linework.openInEditor",
          "when": "linework.isDiagram || activeWebviewPanelId == 'linework.preview'"
        },
        {
          "command": "linework.clearPins",
          "when": "linework.isDiagram || activeWebviewPanelId == 'linework.preview'"
        }
      ]
    },
    "keybindings": [
      {
        "command": "linework.showPreview",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "editorTextFocus && linework.isDiagram"
      }
    ],
    "configuration": {
      "title": "Linework",
      "properties": {
        "linework.preview.theme": {
          "type": "string",
          "default": "auto",
          "markdownDescription": "The look of the preview. `auto`: the diagram's own `theme:`, else light or dark as VS Code is. Any other name wins over the diagram's theme: `light`, `dark`, or a built-in theme (`linework themes` lists them)."
        },
        "linework.preview.debounce": {
          "type": "number",
          "default": 250,
          "minimum": 0,
          "description": "Milliseconds to wait after typing before the preview and the problems are drawn again."
        },
        "linework.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show the engine's problems (the same as `linework validate`) in the Problems panel, with quick fixes where the message names the fix."
        },
        "linework.yamlSchemas": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Give each diagram's type schema to the YAML extension (`redhat.vscode-yaml`), when it is installed, for completion and hover. Unknown and missing keys are left to Linework's own problems, so each is reported once."
        },
        "linework.shareBase": {
          "type": "string",
          "default": "http://localhost:5178/",
          "markdownDescription": "The address of the Linework web editor that share links and **Open in Linework Editor** point at (`pnpm web` serves it at the default). The diagram travels in the link's `#fragment`, which a browser never sends to the server."
        },
        "linework.export.pngScale": {
          "type": "number",
          "default": 2,
          "minimum": 0.5,
          "maximum": 8,
          "description": "Pixels per drawing unit in PNG exports (2 is sharp on most screens and slides)."
        },
        "linework.present.fullScreen": {
          "type": "boolean",
          "default": false,
          "description": "Present also turns VS Code full screen (and back when the presentation closes)."
        }
      }
    }
  },
  "devDependencies": {
    "@linework/core": "workspace:*",
    "@linework/diff": "workspace:*",
    "@linework/engine": "workspace:*",
    "@linework/export": "workspace:*",
    "@linework/mcp": "workspace:*",
    "@linework/theme": "workspace:*",
    "@playwright/test": "^1.65.0",
    "@types/vscode": "1.101.0",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.2",
    "fflate": "0.8.3",
    "yaml": "^2.9.1"
  }
}
